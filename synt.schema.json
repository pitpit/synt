{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/pitpit/synt/main/synt.schema.json",
  "title": "Synt Rack",
  "description": "Schema for a Synt modular synthesizer rack YAML file.",
  "type": "object",
  "required": ["synt"],
  "additionalProperties": false,
  "properties": {
    "synt": {
      "type": "object",
      "required": ["mods"],
      "additionalProperties": false,
      "properties": {
        "rack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Number of slot columns."
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Number of slot rows."
            }
          }
        },
        "mods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Arpeggiator",
                  "Chorus",
                  "ControlMeter",
                  "Flanger",
                  "Gate",
                  "HighPassFilter",
                  "Keyboard",
                  "Knob",
                  "MidiIn",
                  "Oscilloscope",
                  "Panner",
                  "Phaser",
                  "Reverb",
                  "SawtoothOscillator",
                  "SineOscillator",
                  "Speaker",
                  "SquareOscillator",
                  "SwitchOn",
                  "Tremolo",
                  "TriangleOscillator",
                  "Vibrato"
                ],
                "description": "Mod type identifier."
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "description": "Horizontal slot index."
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "description": "Vertical slot index."
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Initial value for Knob mods (0–1)."
              }
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "text"],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "description": "Horizontal pixel position."
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "description": "Vertical pixel position."
              },
              "text": {
                "type": "string",
                "description": "Text content of the annotation."
              }
            }
          }
        }
      }
    }
  }
}
